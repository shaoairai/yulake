FROM node:24-bookworm-slim

# 基本工具
RUN apt-get update && apt-get install -y curl bash

# 安裝 Volta
RUN curl https://get.volta.sh | bash
ENV VOLTA_HOME=/root/.volta
ENV PATH=$VOLTA_HOME/bin:$PATH

WORKDIR /app

# 只先拷貝 package 檔案（關鍵）
COPY yulakefront/package.json yulakefront/package-lock.json* ./

# 用 Volta 安裝指定版本
RUN volta install node@24.12.0 npm@11.6.2

# 安裝前端依賴（只會在 lock 變更時重跑）
RUN npm install
